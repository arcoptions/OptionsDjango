DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Staging uses trading_terminal.settings_staging and fails closed unless these
# values and an isolated PostgreSQL DATABASE_URL containing "staging" are set.
DJANGO_STAGING_ALLOWED_HOSTS=
DJANGO_STAGING_CSRF_TRUSTED_ORIGINS=
ARC_STAGING_DATABASE_MARKER=staging
# Set to 0 on staging unless that environment has its own isolated worker.
ARC_SCANNER_WORKER=1
ARC_AI_BRIEFING_WORKER=0
ARC_BACKGROUND_WORKERS=1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Store AZURE_OPENAI_API_KEY only in the environment secret store.
TELEGRAM_INGEST_TOKEN=
TELEGRAM_INGEST_RATE_LIMIT=120
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
DHAN_SECURITY_ID_FALLBACK=0
NIFTY_CAS_SYMBOLS=
NIFTY_CAS_OUTPUT_DIR=research/cas
# Worker/readiness failures stay in the dashboard and logs unless explicitly enabled.
RADAR_HEALTH_TELEGRAM=0
