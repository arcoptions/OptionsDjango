[Unit]
Description=NIFTY Live Trading Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/opt/optionsdjango
EnvironmentFile=/etc/optionsdjango.env
# Token health is monitored by dhan-token.service and Operations Health. Keep it
# out of ExecStartPre so a slow broker validity request cannot block engine boot.
ExecStart=/opt/optionsdjango/.venv/bin/python -u manage.py run_nifty_live
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
